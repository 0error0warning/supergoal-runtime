+        status=state.status,
+        level=level,
+        color=color,
+        summary=summary,
+        fields=fields,
+        controls=_goal_status_controls(state),
+        debug=debug,
+        updated_at=time.time(),
+        session_short_id=_short_session_id(session_id),
+        plain_text=compact_text or "\n".join(line for line in plain_lines if line),
