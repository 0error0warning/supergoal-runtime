+                        await self._update_supergoal_status_card(event.source, mgr, force=True)
+                    return mgr.status_line(compact=True)
+                if super_mode and not args:
+                    return (
+                        "No active supergoal. Start one explicitly with "
+                        "/supergoal start <goal>."
+                    )
+                return _mode_mismatch_message()
+
+            if lower == "pause":
+                if not _has_control_state():
+                    return _mode_mismatch_message()
