+    for field in fields[1:5]:
+        plain_lines.append(f"{field.label}: {field.value}")
+    return GoalStatusCard(
+        title=f"{label} status",
+        status=state.status,
+        level=level,
+        color=color,
+        summary=summary,
+        fields=fields,
+        controls=_goal_status_controls(state),
+        debug=debug,
+        updated_at=time.time(),
